 */ 기본 설정 */
* {
    box-sizing: border-box;
}
 
html {
    scroll-behavior: smooth;
}
 
body {
    margin: 0;
    font-family: Arial, "Malgun Gothic", sans-serif;
    background-color: #faf9f6;
    color: #252522;
}
 
/* 상단 메뉴 */
.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 7%;
    background-color: white;
    border-bottom: 1px solid #e9e7e0;
}
 
.logo {
    color: #3978e8;
    margin: 0;
    font-size: 28px;
}
 
.menu {
    display: flex;
    gap: 28px;
}
 
.menu a {
    color: #666;
    text-decoration: none;
}
 
.menu a:hover,
.menu a.active {
    color: #3978e8;
}
 
/* 버튼 */
.write-button {
    background-color: #3978e8;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 12px 18px;
    cursor: pointer;
}
 
.write-button:hover {
    background-color: #245fc5;
}
 
.write-button:disabled {
    background-color: #b8c9ec;
    cursor: not-allowed;
}
 
/* 본문 */
.container {
    width: 86%;
    max-width: 1100px;
    margin: 40px auto;
}
 
/* 소개 영역 */
.hero {
    background-color: #edf4ff;
    border-radius: 14px;
    padding: 45px 35px;
    margin-bottom: 40px;
}
 
.subtitle {
    color: #3978e8;
    font-size: 12px;
    letter-spacing: 2px;
}
 
.hero h2 {
    font-size: 32px;
    margin-bottom: 12px;
}
 
.hero p {
    line-height: 1.7;
}
 
/* 공통 박스 (글쓰기, 달력) */
.box {
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 28px;
    margin-bottom: 40px;
}
 
.box h2 {
    margin-top: 0;
}
 
/* 입력 요소 */
.form-row {
    display: flex;
    gap: 10px;
    margin-bottom: 12px;
}
 
input[type="text"],
select,
textarea {
    font-family: inherit;
    font-size: 15px;
    padding: 12px;
    border: 1px solid #d9dce3;
    border-radius: 8px;
    background-color: white;
}
 
input[type="text"] {
    flex: 1;
    min-width: 0;
}
 
textarea {
    width: 100%;
    resize: vertical;
    line-height: 1.7;
    margin-bottom: 12px;
}
 
input:focus,
select:focus,
textarea:focus {
    outline: 2px solid #b8c9ec;
    border-color: #3978e8;
}
 
/* 달력 */
.cal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 16px;
}
 
.cal-header h2 {
    margin: 0;
    font-size: 20px;
}
 
.cal-nav {
    background: #edf4ff;
    color: #3978e8;
    border: none;
    border-radius: 8px;
    width: 38px;
    height: 38px;
    font-size: 22px;
    cursor: pointer;
}
 
.cal-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 4px;
}
 
.cal-weekday {
    text-align: center;
    font-size: 12px;
    color: #999;
    padding: 6px 0;
}
 
.cal-day {
    min-height: 64px;
    padding: 6px 4px;
    border: 1px solid #eee;
    border-radius: 8px;
    background: white;
    cursor: pointer;
    text-align: left;
    font-family: inherit;
    overflow: hidden;
}
 
.cal-day:hover {
    background-color: #f5f9ff;
}
 
.cal-day.today .cal-num {
    background-color: #3978e8;
    color: white;
    border-radius: 50%;
}
 
.cal-day.selected {
    border-color: #3978e8;
    background-color: #edf4ff;
}
 
.cal-day.empty {
    border: none;
    background: none;
    cursor: default;
}
 
.cal-num {
    display: inline-block;
    width: 22px;
    height: 22px;
    line-height: 22px;
    text-align: center;
    font-size: 12px;
}
 
.cal-event {
    display: block;
    margin-top: 2px;
    padding: 1px 4px;
    font-size: 10px;
    color: #245fc5;
    background-color: #dfeaff;
    border-radius: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
 
/* 일정 입력 패널 */
.event-panel {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid #eee;
}
 
.event-panel h3 {
    margin: 0 0 12px;
    font-size: 16px;
}
 
.event-list {
    list-style: none;
    padding: 0;
    margin: 0 0 12px;
}
 
.event-list li {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 12px;
    margin-bottom: 6px;
    background-color: #f5f9ff;
    border-radius: 8px;
    font-size: 14px;
}
 
.event-delete {
    background: none;
    border: none;
    color: #c0392b;
    cursor: pointer;
    font-size: 13px;
}
 
.event-msg {
    margin: 0;
    font-size: 13px;
    color: #c0392b;
    min-height: 18px;
}
 
/* 게시글 제목 영역 */
.section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 20px;
}
 
.section-header h2 {
    margin-bottom: 8px;
}
 
.section-header p {
    color: #777;
    font-size: 14px;
    margin-top: 0;
}
 
/* 게시글 카드 */
.post-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
}
 
.post-card {
    background-color: white;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    padding: 24px;
    transition: transform 0.2s;
}
 
.post-card:hover {
    transform: translateY(-4px);
}
 
.category {
    color: #3978e8;
    font-size: 12px;
}
 
.post-card h3 {
    font-size: 19px;
    margin: 18px 0 12px;
}
 
/* 줄바꿈을 그대로 보여주는 핵심 속성 */
.post-content {
    color: #666;
    font-size: 14px;
    line-height: 1.7;
    white-space: pre-wrap;
    word-break: break-word;
}
 
.post-date {
    color: #999;
    font-size: 12px;
    margin-top: 24px;
}
 
/* 하단 */
footer {
    text-align: center;
    padding: 30px;
    color: #999;
    font-size: 12px;
}
 
/* 모바일 화면 */
@media (max-width: 700px) {
    .header {
        flex-wrap: wrap;
        gap: 16px;
    }
 
    .menu {
        gap: 14px;
    }
 
    .container {
        width: 90%;
    }
 
    .hero h2 {
        font-size: 25px;
    }
 
    .box {
        padding: 20px;
    }
 
    .cal-day {
        min-height: 54px;
    }
 
    .post-list {
        grid-template-columns: 1fr;
    }
}
 